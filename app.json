{
  "expo": {
    "name": "Clearly Reformed",
    "slug": "clearly-reformed",
    "version": "0.1",
    "orientation": "portrait",
    "icon": "./assets/images/cr-app-icon-v5.png",
    "scheme": "clearlyreformed",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/cr-app-icon-v5.png",
      "bundleIdentifier": "com.asherpope.clearly-reformed-swift",
      "buildNumber": "9",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "co.intrinsiclabs.clearlyreformed",
      "icon": "./assets/images/cr-app-icon-v5.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1EBDD",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "react-native-enriched-markdown",
        {
          "enableMath": false,
          "codeHighlight": {
            "enabled": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
