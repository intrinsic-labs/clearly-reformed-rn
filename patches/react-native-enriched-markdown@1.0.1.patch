diff --git a/ios/input/ENRMInputFormatterStyle.mm b/ios/input/ENRMInputFormatterStyle.mm
index fb3c73340289e196ec2471f33dbdf7cd6fc986c4..7289ae2651a64c96f679ce94b2f21d0a6ca3ca85 100644
--- a/ios/input/ENRMInputFormatterStyle.mm
+++ b/ios/input/ENRMInputFormatterStyle.mm
@@ -1,5 +1,6 @@
 #import "ENRMInputFormatterStyle.h"
 #import "FontUtils.h"
+#import <React/RCTFont.h>
 
 @implementation ENRMInputLinkVariantStyle
 @end
@@ -103,8 +104,27 @@ - (UIFont *)headingFontForLevel:(NSInteger)level
   }
 
   NSString *weightString = _headingFontWeights[level];
-  UIFont *font = weightString.length > 0 ? [UIFont systemFontOfSize:size weight:ENRMFontWeightFromString(weightString)]
-                                         : [_baseFont fontWithSize:size];
+  UIFont *font = nil;
+  if (weightString.length > 0) {
+    // Keep the base font's custom family in headings instead of jumping to the
+    // system font; resolve through RCTFont so the family + weight are matched
+    // the same way React Native <Text> does it. Family names starting with a
+    // dot are the system font — those keep the stock behavior below.
+    if (![_baseFont.familyName hasPrefix:@"."]) {
+      font = [RCTFont updateFont:nil
+                      withFamily:_baseFont.familyName
+                            size:@(size)
+                          weight:weightString
+                           style:nil
+                         variant:nil
+                 scaleMultiplier:1.0];
+    }
+    if (font == nil) {
+      font = [UIFont systemFontOfSize:size weight:ENRMFontWeightFromString(weightString)];
+    }
+  } else {
+    font = [_baseFont fontWithSize:size];
+  }
   _headingFontCache[level] = font;
   return font;
 }
